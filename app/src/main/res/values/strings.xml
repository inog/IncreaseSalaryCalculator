    <!-- Negotiation Tips -->
    <string name="dialog_info_title">Salary Negotiation Tips</string>
    <string name="tip_1_title">1. Know Your Market Value</string>
    <string name="tip_1_desc">Research standard salaries in your industry and region for your level of experience before entering negotiations.</string>
    <string name="tip_2_title">2. Quantify Your Achievements</string>
    <string name="tip_2_desc">Highlight measurable successes, completed projects, added responsibilities, and revenue growth you brought to the team.</string>
    <string name="tip_3_title">3. Define an Anchor &amp; Alternatives</string>
    <string name="tip_3_desc">Start with a well-reasoned upper target. If direct base salary is capped, negotiate bonuses, mobility budget, home office days, or training allowances.</string>
    <string name="tip_4_title">4. Focus on Future Value</string>
    <string name="tip_4_desc">Explain how you plan to contribute to the company\'s future goals and take on higher-impact challenges.</string>
